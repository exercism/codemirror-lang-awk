{
  "name": "@exercism/codemirror-lang-awk",
  "version": "2.0.1",
  "description": "CodeMirror 6 plugin and language support for GNU AWK",
  "author": {
    "name": "Glenn Jackman",
    "email": "glenn.jackman@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exercism/codemirror-lang-awk.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "tsc --noEmit",
    "test:runner": "esbuild test/test-runner.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/awk-test-runner.mjs && node node_modules/.cache/awk-test-runner.mjs"
  },
  "keywords": [
    "codemirror",
    "codemirror-6",
    "awk",
    "gawk",
    "gnu-awk",
    "syntax-highlighting",
    "editor"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/language": "^6.10.1",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.33.0",
    "@lezer/highlight": "^1.2.0",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
